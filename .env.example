# ── LLM (optional) ──────────────────────────────────────────────────────────
# Set GROQ_API_KEY to enable natural-language explanations in /investigate.
# Without it the assistant uses a deterministic template (always works).
GROQ_API_KEY=gsk_...
LLM_MODEL=qwen/qwen3-27b

# ── Model & feature store paths ──────────────────────────────────────────────
# Default values work for local development (no need to set these).
MODEL_DIR=artifacts/model
FEATURE_FILE=data/ieee_ready.npz

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite is used automatically when DATABASE_URL is not set.
# Uncomment the line below for PostgreSQL (used by docker compose).
DATABASE_URL=sqlite:///finguard.db
# DATABASE_URL=postgresql+psycopg2://finguard:finguard@localhost:5432/finguard

# ── Redis cache ───────────────────────────────────────────────────────────────
# Optional — the API works without Redis, just without score caching.
# REDIS_URL=redis://localhost:6379/0

# ── MLflow tracking ───────────────────────────────────────────────────────────
# Default: local SQLite file (mlflow.db). Uncomment for a remote server.
# MLFLOW_TRACKING_URI=http://localhost:5000
